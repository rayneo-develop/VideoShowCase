<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000"
    android:keepScreenOn="true"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="Streaming\nSwipe to change focus, tap to trigger, double tap to exit"
        android:textColor="@color/white"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvResolution"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="Current resolution —"
        android:textColor="@color/white"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvFrameRate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="Current frame rate —"
        android:textColor="@color/white"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/btnStartStream"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Start streaming"
        android:textColor="@color/white" />

    <TextView
        android:id="@+id/btnStopStream"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="4dp"
        android:enabled="false"
        android:gravity="center"
        android:text="Stop streaming"
        android:textColor="@color/white" />

</LinearLayout>
